<Window x:Class="TypeReader.App.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Type Reader" Width="120" Height="48"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="Transparent" AllowsTransparency="True"
        TextOptions.TextRenderingMode="ClearType" TextOptions.TextFormattingMode="Ideal">
    <Grid Background="#01000000">
        <!-- The Grid's near-invisible background (alpha 1/255) is the OS-level
             hit layer: layered windows are click-through where alpha == 0.
             It is NEVER animated. The hover glass animates MainBorder instead
             (FluentFlyout separates these the same way). -->
        <Border x:Name="MainBorder" CornerRadius="6" Margin="2" Background="Transparent"
                MouseEnter="OnMouseEnter" MouseLeave="OnMouseLeave">
            <Border x:Name="TopBorder" BorderThickness="0,1.25,0,0" CornerRadius="5"
                    BorderBrush="Transparent">
                <!-- vertical optical centering: WPF centers the line box, which
                     leaves cap-height glyphs visibly low; ApplySettings applies
                     a font-size-scaled upward nudge to compensate -->
                <TextBlock x:Name="KeyText" Text="…" FontFamily="Segoe UI" FontSize="14"
                           Foreground="White" VerticalAlignment="Center"
                           HorizontalAlignment="Center" Padding="8,2">
                    <TextBlock.ContextMenu>
                        <ContextMenu x:Name="KeyMenu">
                            <ui:MenuItem Header="Settings" Click="OnSettings">
                                <ui:MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="Settings24"/>
                                </ui:MenuItem.Icon>
                            </ui:MenuItem>
                            <ui:MenuItem x:Name="TrayToggleItem" Header="Hide tray icon" Click="OnToggleTrayIcon">
                                <ui:MenuItem.Icon>
                                    <ui:SymbolIcon x:Name="TrayToggleIcon" Symbol="EyeOff24"/>
                                </ui:MenuItem.Icon>
                            </ui:MenuItem>
                            <Separator/>
                            <ui:MenuItem Header="Quit" Click="OnQuit">
                                <ui:MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="Dismiss24"/>
                                </ui:MenuItem.Icon>
                            </ui:MenuItem>
                        </ContextMenu>
                    </TextBlock.ContextMenu>
                </TextBlock>
            </Border>
        </Border>
    </Grid>
</Window>