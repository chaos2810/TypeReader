<Window x:Class="TypeReader.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Type Reader Settings" Width="360" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock Text="Size"/>
        <ComboBox x:Name="SizeBox" SelectionChanged="OnSizeChanged"/>
        <TextBlock Text="Preview" Margin="0,12,0,0"/>
        <TextBlock x:Name="PreviewText" Text="Aa Bb 123" Margin="0,4,0,0"/>
        <TextBlock Text="Position" Margin="0,12,0,0"/>
        <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="PosLeft" Content="Left" Margin="0,0,12,0" Checked="OnPositionChanged"/>
            <RadioButton x:Name="PosCenter" Content="Center" Margin="0,0,12,0" Checked="OnPositionChanged"/>
            <RadioButton x:Name="PosRight" Content="Right" Checked="OnPositionChanged"/>
        </StackPanel>
    </StackPanel>
</Window>