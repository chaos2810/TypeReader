<ui:FluentWindow x:Class="TypeReader.App.ImageCropWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Crop image" Width="760" Height="500"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True"
        PreviewMouseWheel="OnViewportWheel"
        PreviewKeyDown="OnPreviewKeyDown" PreviewKeyUp="OnPreviewKeyUp">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Title="Crop image" Grid.Row="0" ShowMaximize="False" ShowMinimize="False"/>
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderBrush="#66888888" BorderThickness="1" ClipToBounds="True">
                <Grid x:Name="Viewport" Background="#202020" Focusable="True"
                      MouseLeftButtonDown="OnViewportLeftDown"
                      MouseDown="OnViewportMouseDown"
                      MouseMove="OnViewportMouseMove"
                      MouseLeftButtonUp="OnViewportMouseUp"
                      MouseUp="OnViewportMouseUp">
                    <Canvas x:Name="CropCanvas"/>
                </Grid>
            </Border>
            <StackPanel Grid.Column="1" Width="220" Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Taskbar preview" HorizontalAlignment="Center"/>
                <!-- fixed taskbar-shaped frame; the image shrinks inside it
                     via the Image size slider, centered like the widget -->
                <Border Width="192" Height="60" CornerRadius="6" Padding="6" Margin="0,8,0,0"
                        HorizontalAlignment="Center" Background="#CC202020">
                    <Image x:Name="PreviewImage" MaxWidth="180" MaxHeight="48" Stretch="Uniform"/>
                </Border>
                <TextBlock Text="Image size" Margin="0,16,0,0"/>
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="48"/>
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="SizeSlider" Grid.Column="0" Minimum="0.25" Maximum="1"
                            SmallChange="0.05" LargeChange="0.1"
                            ValueChanged="OnSizeSliderChanged"/>
                    <TextBlock x:Name="SizeLabel" Grid.Column="1" Text="100%"
                               VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
                <TextBlock Text="Scroll to zoom · Ctrl+/-/0 · drag the shaded area to pan · drag the frame or its handles to adjust the crop (locked to the taskbar shape)."
                           TextWrapping="Wrap" FontSize="12" Margin="0,16,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <Button Content="Whole image" Margin="0,24,0,0" Click="OnUseWholeImage"/>
                <Button Content="Cancel" Margin="0,8,0,0" Click="OnCancel"/>
                <Button Content="Confirm" Margin="0,8,0,0" Click="OnConfirm"/>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
